					type: "xp"
					xp: 150
				}
			]
			title: "O Mixer"
			description: [
				"&7O primeiro coração não pede fogo, só paciência: um batedor girando sobre uma bacia até que tudo vire uma coisa só."
				""
				"&6Objetivo:&r Construa um &6Mechanical Mixer&r. O Coração II é forjado nele, sobre uma &6Basin&r, sem calor."
				""
				"&8Ele precisa de força rotacional: uma roda d'água ou um moinho de vento bastam."
			]
		}
		{
			id: "714776FD39A0F36C"
			x: 5.2d
			y: 0.0d
			dependencies: [
				"567093696FAF5491"
			]
			tasks: [
