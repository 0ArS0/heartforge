					item: {
						count: 1
						id: "comamigos_balance:loot_bag_epica"
					}
				}
			]
			title: "Viajante Atemporal"
			subtitle: "&8Opcional"
			description: [
				"&7Florestas de ametista, colinas de fogo, dunas prismáticas, pântanos distorcidos, tundras de gelo e de carne: o End é um continente."
				"&7O vazio também tem inverno; nas terras geladas, até o fôlego congela."
				"&7E o jardineiro mais teimoso da crônica planta uma flor do vazio em cada mundo, só para provar que pode."
				""
				"&6Objetivo:&r 1. Descubra &6todos os biomas&r do End."
				"&f2. Vista um conjunto completo de &6armadura de couro&r num dos biomas mais frios do End."
				"&f3. Plante uma &6Flor do Coro&r em cada dimensão (sobre pedra do End levada para lá)."
			]
			optional: true
		}
