					count: 1L
				}
				{
					id: "2601A347A2513485"
					type: "item"
					item: {
						count: 1
						id: "wildernature:truffle"
					}
					count: 1L
				}
			]
			rewards: [
				{
					id: "515059AC12F53B6F"
					type: "xp"
					xp: 350
