			title: "Todas as Luas"
			subtitle: "&8Opcional"
			description: [
				"&7Cinco luas, cinco maldições. O elokosa morto solta a pata da fase daquela noite,"
				"&7e quem tem todas manda nas noites da selva."
				""
				"&6Objetivo:&r 1. Pata da lua &6Nova&r (eclipse: anula efeitos)."
				"&f2. Pata da lua &6Crescente&r (fragilidade)."
				"&f3. Pata da &6Meia&r lua (cansaço de mineração)."
				"&f4. Pata da lua &6Gibosa&r (lentidão)."
			]
			optional: true
		}
