			rewards: [
				{
					id: "654A73935271F66E"
					type: "xp"
					xp: 5
				}
			]
			title: "Magias e Terras Seladas"
			description: [
				"&7Os arcanistas aprendem como os ferreiros: degrau por degrau. Feitiço grande demais queima a mão de quem ainda não subiu."
				"&7E há terras que o mundo mantém fechadas. No &cNether&7, o &6Ar Escaldante&7 cozinha os intrusos devagar, até derreter-lhes as entranhas. O &5End&7 nem sequer responde ao chamado."
				""
				"&6Objetivo:&r Respeite os selos:"
				"&f- Raridade das magias: &7Comum&f no I, &aIncomum&f no II, &9Rara&f no III, &5Épica&f no V, &6Lendária&f no VI."
				"&f- O &cNether&f só é seguro a partir do &6Tier IV&f; antes disso, o Ar Escaldante mata aos poucos."
				"&f- O &5End&f só se abre no &dTier VII&f."
			]
		}
		{
			id: "22ACB16E3BB57B38"
			x: 4.0d
			y: 0.0d
			dependencies: [
				"07C2E697F0CCD2A8"
				"3A20D9B55B581149"
			]
			tasks: [
