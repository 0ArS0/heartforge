	"quest.0B0D6CAF2F6BB19E.title": "O Fantasma da Capitã Cornelia"
	"quest.0B0D6CAF2F6BB19E.quest_desc": [
		"No mar gelado do Aquamirae, a &bCapitã Cornelia&r ainda comanda seu navio."
		"Derrote-a para obter o &cCoração da Cornelia&r."
	]
	"quest.2820CCA849119B77.title": "Elixir Purificador I"
	"quest.2820CCA849119B77.quest_desc": [
		"Cura a &cIndigestão&r de quem comeu o Coração II."
		"Mel, leite (Farmer's Delight), cenoura dourada e melancia reluzente."
	]
	"quest.7F1988C32BAA160D.title": "Forjar o Coração do Tier III"
	"quest.7F1988C32BAA160D.quest_desc": [
		"No &6Mechanical Crafter&r: Coração da Cornelia, latão, precision mechanism, runas, tinta incomum, gema sintonizada, metal sombrio, presa de troll, eco do cemitério e item de facção II."
	]
	"quest.31B1521C66801A23.title": "Comer o Coração: Tier III"
	"quest.31B1521C66801A23.quest_desc": [
