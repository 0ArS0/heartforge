{
	"quest.7C01C4060A084AAC.title": "Bem-vindo a Heartforge"
	"quest.7C01C4060A084AAC.quest_desc": [
		"Este mundo tem &68 tiers de progressão&r, compartilhados por todo o grupo."
		""
		"Cada tier libera equipamentos, magias e terras. Para subir, o grupo forja um &cCoração do Tier&r com o coração do boss-chave do tier atual e um item de cada mod, nas máquinas do &6Create&r."
		""
		"Use &e/tier&r para ver em que tier o grupo está."
	]
	"quest.07C2E697F0CCD2A8.title": "Equipamento acima do seu tier"
	"quest.07C2E697F0CCD2A8.quest_desc": [
		"Você &epode&r usar armas, armaduras e ferramentas acima do tier do grupo, mas paga caro:"
		"- &cArmas&r: menos dano e &cArma Pesada&r."
		"- &cArmaduras&r: menos proteção e &cLentidão&r."
		"- &cFerramentas&r: &cInexperiência&r, não colhem os blocos mais duros."
		"- &cArcos&r: &cMira Trêmula&r."
		"Tudo isso gasta a durabilidade muito mais rápido. O tooltip de cada item mostra o tier dele."
	]
	"quest.3A20D9B55B581149.title": "Magias e terras"
	"quest.3A20D9B55B581149.quest_desc": [
		"Raridade das magias (Iron's Spells) por tier: &7Comum I&r, &aIncomum II&r, &9Rara III&r, &5Épica V&r, &6Lendária VI&r."
		""
		"O &cNether&r abre de verdade no &6Tier IV&r: antes disso o &6Ar Escaldante&r vai cozinhar você aos poucos, até derreter seus órgãos."
		"O &5End&r só abre no &dTier VII&r."
	]
	"quest.22ACB16E3BB57B38.title": "Corações cobram um preço"
	"quest.22ACB16E3BB57B38.quest_desc": [
		"Quem &ccome&r um Coração do Tier carrega uma &cMaldição&r para sempre: nem leite, nem a morte tiram."
		"Só o &bElixir Purificador&r cura. Ele tem níveis I a VII e cada nível é feito a partir do anterior."
		"Decidam juntos quem vai pagar o preço por todos."
	]
	"quest.52F783AE782EF818.title": "Raça, classe e origem"
	"quest.52F783AE782EF818.quest_desc": [
		"Escolha sua &eraça&r, &eclasse&r e &eorigem&r (NeoOrigins). Raças imunes a fogo aguentam mais o Nether, mas não para sempre."
	]
	"quest.05040E760D6C02A5.title": "Receitas no EMI"
	"quest.05040E760D6C02A5.quest_desc": [
		"As receitas do Create (mixer, mechanical crafter, sequenced assembly) aparecem no EMI quando o &eJEI&r também está instalado."
		"Equipamentos de &9Tier III&r para cima são feitos no &6Mechanical Crafter&r, com um &6Precision Mechanism&r."
	]
	"quest.20E796F357403DF2.title": "Começo do Tier I"
	"quest.20E796F357403DF2.quest_desc": [
		"O grupo está no &7Tier I - Andarilho&r."
		"Siga as trilhas de cada mod. Todas levam aos ingredientes do próximo coração."
	]
	"quest.2E39DCE9262A21D9.title": "Liga de Andesito"
	"quest.2E39DCE9262A21D9.quest_desc": [
		"A base de toda máquina do Create."
	]
	"quest.567093696FAF5491.title": "O Mixer"
	"quest.567093696FAF5491.quest_desc": [
		"O primeiro coração é forjado num &6Mechanical Mixer&r (sem calor)."
	]
	"quest.015D5B59A18712EF.title": "Lexica Botania"
	"quest.015D5B59A18712EF.quest_desc": [
		"O livro da Botânica explica tudo."
	]
	"quest.36165EEC9BE9AD64.title": "Mana"
	"quest.36165EEC9BE9AD64.quest_desc": [
		"Uma Mana Pool cheia e uma Pure Daisy levam ao &bManasteel&r."
	]
	"quest.0FC1DB6776AEB8DD.title": "Manasteel"
	"quest.0FC1DB6776AEB8DD.quest_desc": [
		"Ingrediente do Coração II."
	]
	"quest.1BB41468E12100DB.title": "Mesa de Inscrição"
	"quest.1BB41468E12100DB.quest_desc": [
		"Iron's Spells: aprenda a escrever pergaminhos."
	]
	"quest.717145DFA5D697D8.title": "Tinta Comum"
	"quest.717145DFA5D697D8.quest_desc": [
		"Ingrediente do Coração II."
	]
	"quest.100E4AF8E871BDB0.title": "Prata do Ocultismo"
	"quest.100E4AF8E871BDB0.quest_desc": [
		"Occultism: a prata abre os rituais. Ingrediente do Coração II."
	]
	"quest.1B173011839FC25E.title": "Mythril dos Anões"
	"quest.1B173011839FC25E.quest_desc": [
		"Fundido do minério das fortalezas anãs. Ingrediente do Coração II."
	]
	"quest.3D950DE8885DE435.title": "Escolha seu lado"
	"quest.3D950DE8885DE435.quest_desc": [
		"Vampiro, caçador ou lobisomem: um item da sua facção (presa de vampiro, coração humano ou dente de lobisomem) entra no coração."
	]
	"quest.6674E7F2C4266BDC.title": "Torta de Maçã"
	"quest.6674E7F2C4266BDC.quest_desc": [
		"Farmer's Delight: até o coração precisa de um toque de comida."
	]
	"quest.3B98D4797C00C492.title": "O Rei Anão Esqueleto"
	"quest.3B98D4797C00C492.quest_desc": [
		"O &eRei Anão Esqueleto&r governa as fortalezas subterrâneas dos anões."
		"Derrote-o para obter o &cCoração do Rei Anão&r."
	]
	"quest.3CAB53366B184275.title": "Forjar o Coração do Tier II"
	"quest.3CAB53366B184275.quest_desc": [
		"No &6Mixer&r: Coração do Rei Anão, liga de andesito, mythril, manasteel, tinta comum, prata do Occultism, item de facção e torta de maçã."
	]
	"quest.1CABC71AF09A60B7.title": "Comer o Coração: Tier II"
	"quest.1CABC71AF09A60B7.quest_desc": [
		"Alguém do grupo come o coração e todos sobem para o &aTier II - Aprendiz&r."
		"Lembre: quem come carrega a maldição."
	]
	"quest.47FF0B2D7185F617.title": "Começo do Tier II"
	"quest.47FF0B2D7185F617.quest_desc": [
		"O grupo está no &aTier II - Aprendiz&r."
		"Siga as trilhas de cada mod. Todas levam aos ingredientes do próximo coração."
	]
	"quest.0E885F597F41B8C0.title": "Latão"
	"quest.0E885F597F41B8C0.quest_desc": [
		"Misture cobre e zinco aquecidos no mixer."
	]
	"quest.671BD4E1392266A3.title": "Precision Mechanism"
	"quest.671BD4E1392266A3.quest_desc": [
		"Sua primeira linha de montagem sequencial."
	]
	"quest.20A3640DB58E167D.title": "Mechanical Crafter"
	"quest.20A3640DB58E167D.quest_desc": [
		"O Coração III e os equipamentos avançados nascem aqui."
	]
	"quest.1D81A4A503A9EB37.title": "Altar Rúnico"
	"quest.1D81A4A503A9EB37.quest_desc": [
		"Runas são a linguagem da Botânica."
	]
	"quest.18236F78CCBF739D.title": "Uma Runa"
	"quest.18236F78CCBF739D.quest_desc": [
		"Qualquer runa serve no coração (exemplo: Água)."
	]
	"quest.38F122B21B6E51CC.title": "Tinta Incomum"
	"quest.38F122B21B6E51CC.quest_desc": [
