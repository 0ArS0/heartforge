	"quest.4BA670228063678E.title": "Forjar o Coração do Tier VIII"
	"quest.4BA670228063678E.quest_desc": [
		"Montagem sequencial: Coração do Dragão do Fim + sopro do dragão, pele de dragão, núcleo do vazio, anel do Doppelganger, cabeça de Gaia e prensa."
