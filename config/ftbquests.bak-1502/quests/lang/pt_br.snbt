	"quest.5198DB6539E0C7C3.title": "Elixir Purificador VII"
	"quest.5198DB6539E0C7C3.quest_desc": [
		"Cura o &cVazio Interior&r (Coração VIII) e todas as outras maldições. Elixir VI + estrela do Nether, fragmento de eco, fruta do coro e pó de fada."
	]
	"quest.0179B488D5D00F0D.title": "O Obsidilith"
	"quest.0179B488D5D00F0D.quest_desc": [
		"Nas ilhas do End, o &8Obsidilith&r espera."
