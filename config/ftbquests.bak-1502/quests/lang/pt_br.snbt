	"quest.7DC7ED3CB1245DBE.title": "Comer o Coração: Tier VIII"
	"quest.7DC7ED3CB1245DBE.quest_desc": [
		"Alguém do grupo come o coração e todos sobem para o &eTier VIII - Divino&r."
